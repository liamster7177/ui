local DROIDWARE_UI_VERSION = "1.0"

-- ===========================================================
-- DROIDWARE UI
-- Linoria-flavoured: flat, dense, 1px outlines, square-ish.
-- Drop-in for the call surface the DROIDWARE hub uses.
--
-- Rules this library holds to:
--   * no coordinate is a magic constant; everything derives
--     from the window size, so resize reflows live
--   * columns auto-fit, so labels never get squeezed and
--     never need truncating to fit
--   * one styling path: the window and every pop-out panel
--     are built by the same two functions
-- ===========================================================

local UIS     = game:GetService("UserInputService")
local TS      = game:GetService("TweenService")
local RUN     = game:GetService("RunService")
local TEXT    = game:GetService("TextService")
local Players = game:GetService("Players")
local LP      = Players.LocalPlayer

local library = {}

-- ---------- palette ----------
library.accentColor   = Color3.fromRGB(222, 38, 48)
library.accentSoft    = Color3.fromRGB(118, 24, 32)
library.outerColor    = Color3.fromRGB(0, 0, 0)
library.bgColor       = Color3.fromRGB(13, 12, 15)
library.edgeColor     = Color3.fromRGB(28, 23, 30)
library.surfaceColor  = Color3.fromRGB(24, 22, 27)
library.inputColor    = Color3.fromRGB(33, 30, 36)
library.strokeColor   = Color3.fromRGB(62, 56, 68)
library.dropdownMaxRows = 10
library.icon          = "https://raw.githubusercontent.com/liamster7177/ui/main/IMG_1522%202.PNG"
library.textColor     = Color3.fromRGB(235, 235, 238)
library.textSecondary = Color3.fromRGB(198, 198, 204)
library.textMuted     = Color3.fromRGB(128, 128, 136)
library.title         = "DROIDWARE"
library.version       = ""
local function pickFont(names, fallback)
    for _, n in ipairs(names) do
        local ok, f = pcall(function() return Enum.Font[n] end)
        if ok and f then return f end
    end
    return fallback
end
library.font     = pickFont({ "BuilderSans", "Montserrat", "Ubuntu", "Gotham" }, Enum.Font.Gotham)
library.fontMed  = pickFont({ "BuilderSansMedium", "GothamMedium" }, Enum.Font.GothamMedium)
library.fontBold = pickFont({ "BuilderSansBold", "MontserratBold", "GothamBold" }, Enum.Font.GothamBold)

-- ---------- metrics ----------
library.windowWidth  = 980
library.windowHeight = 580
local RADIUS   = 6
local NAV_W    = 158
local HEADER_H = 34
local PAD      = 8
local COL_MIN  = 228    -- a column narrower than this truncates labels
local COL_GAP  = 8
local ROW_H    = 22     -- dense rows
local MIN_W, MAX_W = 680, 1920
local MIN_H, MAX_H = 420, 1080

library._screenGuis  = {}
library._connections = {}
library._flags       = {}
library.Flags        = library._flags
library._themeHooks  = {}

local function host()
    return (typeof(gethui) == "function" and gethui()) or game:GetService("CoreGui")
end

local function conn(c)
    library._connections[#library._connections + 1] = c
    return c
end

-- Enum.Font has no BuilderSans on many clients, so Font/FontFace is the
-- only way to actually get a modern face. Every text object this library
-- builds goes through new(), so upgrading here covers all of them.
library.fontFamily = "rbxasset://fonts/families/BuilderSans.json"
local FONTFACE_OK = pcall(function()
    return Font.new("rbxasset://fonts/families/BuilderSans.json", Enum.FontWeight.Regular)
end)

local function new(class, props, parent)
    local o = Instance.new(class)
    for k, v in pairs(props or {}) do o[k] = v end
    if FONTFACE_OK and props and props.Font ~= nil then
        local weight = Enum.FontWeight.Regular
        if     props.Font == library.fontBold then weight = Enum.FontWeight.Bold
        elseif props.Font == library.fontMed  then weight = Enum.FontWeight.Medium end
        pcall(function() o.FontFace = Font.new(library.fontFamily, weight) end)
    end
    if parent then o.Parent = parent end
    return o
end

local function corner(o, r)
    return new("UICorner", { CornerRadius = UDim.new(0, r or RADIUS) }, o)
end

-- Linoria's signature: a 1px line, not a glow.
local function outline(o, color, transparency)
    return new("UIStroke", {
        Color = color or library.strokeColor,
        Transparency = transparency or 0,
        Thickness = 1,
        ApplyStrokeMode = Enum.ApplyStrokeMode.Border,
    }, o)
end
local stroke = outline

local function padding(o, l, r, t, b)
    return new("UIPadding", {
        PaddingLeft   = UDim.new(0, l or 0),
        PaddingRight  = UDim.new(0, r or l or 0),
        PaddingTop    = UDim.new(0, t or 0),
        PaddingBottom = UDim.new(0, b or t or 0),
    }, o)
end

local function list(o, pad, dir)
    return new("UIListLayout", {
        SortOrder = Enum.SortOrder.LayoutOrder,
        Padding = UDim.new(0, pad or 4),
        FillDirection = dir or Enum.FillDirection.Vertical,
    }, o)
end

-- UIS:GetMouseLocation() is measured BELOW the topbar inset, while
-- AbsolutePosition inside an IgnoreGuiInset ScreenGui is measured from the
-- true top of the screen. Comparing the two directly is off by the inset
-- (36px on most clients), which makes every hit test miss. Use this for
-- anything compared against AbsolutePosition.
local GuiService = game:GetService("GuiService")
local function mouseAbs()
    local m = UIS:GetMouseLocation()
    local ok, inset = pcall(function() return GuiService:GetGuiInset() end)
    if ok and inset then return Vector2.new(m.X + inset.X, m.Y + inset.Y) end
    return m
end

local function lerpColor(a, b, t) return a:Lerp(b, t) end

-- A vertical sheen. Every surface gets one, which is what stops a
-- flat fill reading as unfinished.
local function sheen(o, top, mid, bot, rotation)
    return new("UIGradient", {
        Rotation = rotation or 112,
        Color = ColorSequence.new{
            ColorSequenceKeypoint.new(0.00, top),
            ColorSequenceKeypoint.new(0.52, mid),
            ColorSequenceKeypoint.new(1.00, bot),
        },
    }, o)
end

-- A soft accent bloom built from a gradient rather than a sliced PNG,
-- so it renders without shipping an image asset.
local function bloom(parent, color, transparency, size, position, rot)
    local g = new("Frame", {
        Name = "bloom",
        BackgroundColor3 = color or library.accentColor,
        BorderSizePixel = 0,
        Size = size or UDim2.new(0.7, 0, 0, 180),
        Position = position or UDim2.new(0, -40, 0, -90),
        ZIndex = 0,
    }, parent)
    corner(g, 99)
    new("UIGradient", {
        Rotation = rot or 90,
        Transparency = NumberSequence.new{
            NumberSequenceKeypoint.new(0.00, transparency or 0.86),
            NumberSequenceKeypoint.new(0.55, (transparency or 0.86) + (1 - (transparency or 0.86)) * 0.55),
            NumberSequenceKeypoint.new(1.00, 1),
        },
    }, g)
    return g
end

-- A halo: three strokes at falling opacity reads as a glow.
local function halo(o, color)
    local a = new("UIStroke", { Color = color, Transparency = 0.55, Thickness = 1,
        ApplyStrokeMode = Enum.ApplyStrokeMode.Border }, o)
    local b = new("UIStroke", { Color = color, Transparency = 0.86, Thickness = 3,
        ApplyStrokeMode = Enum.ApplyStrokeMode.Border }, o)
    local c = new("UIStroke", { Color = color, Transparency = 0.94, Thickness = 6,
        ApplyStrokeMode = Enum.ApplyStrokeMode.Border }, o)
    return a, b, c
end

local function tween(o, t, props)
    TS:Create(o, TweenInfo.new(t or 0.1, Enum.EasingStyle.Quad, Enum.EasingDirection.Out), props):Play()
end

function library:SetAccentColor(c)
    if typeof(c) ~= "Color3" then return self end
    self.accentColor = c
    local h, s, v = c:ToHSV()
    self.accentSoft = Color3.fromHSV(h, math.min(1, s * 1.02), math.max(0, v * 0.5))
    for _, fn in ipairs(self._themeHooks or {}) do pcall(fn) end
    return self
end
function library:OnTheme(fn) self._themeHooks[#self._themeHooks + 1] = fn end
function library:ApplyTheme()
    for _, fn in ipairs(self._themeHooks) do pcall(fn) end
end

function library:Skin()
    return {
        accent = self.accentColor, soft = self.accentSoft,
        bg = self.bgColor, edge = self.edgeColor, surface = self.surfaceColor,
        strokeC = self.strokeColor, text = self.textColor,
        text2 = self.textSecondary, muted = self.textMuted,
    }
end

function library:Host() return host() end

function library:HoldConn(gui, c)
    if not (gui and c) then return c end
    self._dwConns = self._dwConns or setmetatable({}, { __mode = "k" })
    local l = self._dwConns[gui]
    if not l then
        l = {}
        self._dwConns[gui] = l
        gui.AncestryChanged:Connect(function(_, p)
            if p then return end
            for _, x in ipairs(l) do pcall(function() x:Disconnect() end) end
            table.clear(l)
        end)
    end
    l[#l + 1] = c
    return c
end

-- ===========================================================
-- Chrome: the frame, the header, dragging, and the single
-- bottom-right resize corner.
--
-- Edges and the other three corners DRAG. Only the bottom-right
-- corner resizes.
-- ===========================================================

-- Load an image from a URL or an asset id, for the header picture.
function library:LoadIcon(source, filename)
    if not source or source == "" then return nil end
    if tostring(source):match("^rbxassetid://") then return source end
    if tostring(source):match("^%d+$") then return "rbxassetid://" .. source end
    filename = filename or "droidware_icon.png"
    if typeof(getcustomasset) ~= "function" or typeof(writefile) ~= "function" then
        warn("[DROIDWARE UI] icon: this executor has no writefile/getcustomasset")
        return nil
    end
    -- a cached file from a previous run saves the download
    if typeof(isfile) == "function" and isfile(filename) then
        local okc, cached = pcall(getcustomasset, filename)
        if okc and cached then return cached end
    end
    local okGet, data = pcall(function() return game:HttpGet(source) end)
    if not okGet or type(data) ~= "string" or #data < 100 then
        warn("[DROIDWARE UI] icon: could not download " .. tostring(source))
        return nil
    end
    local okWrite = pcall(writefile, filename, data)
    if not okWrite then
        warn("[DROIDWARE UI] icon: writefile was refused")
        return nil
    end
    local okAsset, id = pcall(getcustomasset, filename)
    if not okAsset or not id then
        warn("[DROIDWARE UI] icon: getcustomasset failed (image may be corrupt)")
        return nil
    end
    return id
end

-- Smooth drag, eased so it carries weight.
function library:MakeDraggable(obj, handle, latency)
    latency = latency or 0.045
    handle  = handle or obj
    handle.Active = true
    local held, moving, start, startPos = false, nil, nil, nil

    handle.InputBegan:Connect(function(i)
        if i.UserInputType ~= Enum.UserInputType.MouseButton1
        and i.UserInputType ~= Enum.UserInputType.Touch then return end
        held, start, startPos = true, i.Position, obj.Position
        i.Changed:Connect(function()
            if i.UserInputState == Enum.UserInputState.End then held = false end
        end)
    end)
    handle.InputChanged:Connect(function(i)
        if i.UserInputType == Enum.UserInputType.MouseMovement
        or i.UserInputType == Enum.UserInputType.Touch then moving = i end
    end)
    self:HoldConn(obj, UIS.InputChanged:Connect(function(i)
        if i ~= moving or not held then return end
        local d = i.Position - start
        tween(obj, latency, {
            Position = UDim2.new(startPos.X.Scale, startPos.X.Offset + d.X,
                                 startPos.Y.Scale, startPos.Y.Offset + d.Y)
        })
    end))
end

-- Border handles. Sides and three corners drag the frame; the
-- bottom-right corner is the only one that resizes.
function library:AddEdgeHandles(frame, opts)
    opts = opts or {}
    local E = opts.margin or 7
    local minW, minH = opts.minW or 240, opts.minH or 150
    local maxW, maxH = opts.maxW or MAX_W, opts.maxH or MAX_H
    local onLive, onDone = opts.onLive, opts.onDone

    -- drag zones: every edge and the three non-resizing corners
    local DRAG = {
        { UDim2.new(1, -E * 2, 0, E), UDim2.new(0, E, 0, 0) },            -- top
        { UDim2.new(0, E, 1, -E * 2), UDim2.new(0, 0, 0, E) },            -- left
        { UDim2.new(0, E, 1, -E * 2), UDim2.new(1, -E, 0, E) },           -- right
        { UDim2.new(1, -E * 3, 0, E), UDim2.new(0, E, 1, -E) },           -- bottom, minus the grip
        { UDim2.fromOffset(E * 2, E * 2), UDim2.new(0, 0, 0, 0) },        -- NW
        { UDim2.fromOffset(E * 2, E * 2), UDim2.new(1, -E * 2, 0, 0) },   -- NE
        { UDim2.fromOffset(E * 2, E * 2), UDim2.new(0, 0, 1, -E * 2) },   -- SW
    }
    for i, z in ipairs(DRAG) do
        local b = new("TextButton", {
            Name = "dragEdge" .. i, Size = z[1], Position = z[2],
            BackgroundTransparency = 1, Text = "", AutoButtonColor = false,
            ZIndex = 61,
        }, frame)
        self:MakeDraggable(frame, b)
    end

    -- the one resize corner
    local grip = new("TextButton", {
        Name = "resizeGrip",
        AnchorPoint = Vector2.new(1, 1),
        Position = UDim2.new(1, -3, 1, -3),
        Size = UDim2.fromOffset(14, 14),
        BackgroundTransparency = 1,
        Text = "", AutoButtonColor = false, ZIndex = 62,
    }, frame)

    -- three stacked ticks, the usual grip mark
    local ticks = {}
    for i = 1, 3 do
        local t = new("Frame", {
            Name = "tick" .. i,
            AnchorPoint = Vector2.new(1, 1),
            Position = UDim2.new(1, -(i - 1) * 4, 1, 0),
            Size = UDim2.fromOffset(2, i * 4),
            BackgroundColor3 = library.textMuted,
            BackgroundTransparency = 0.45,
            BorderSizePixel = 0, ZIndex = 63,
        }, grip)
        corner(t, 1)
        ticks[i] = t
    end

    local sizing = false
    local function paintGrip(on)
        for _, t in ipairs(ticks) do
            tween(t, 0.1, {
                BackgroundColor3 = on and library.accentColor or library.textMuted,
                BackgroundTransparency = on and 0 or 0.45,
            })
        end
    end
    grip.MouseEnter:Connect(function() paintGrip(true) end)
    grip.MouseLeave:Connect(function() if not sizing then paintGrip(false) end end)

    local sw, sh, sm = 0, 0, nil
    grip.InputBegan:Connect(function(i)
        if i.UserInputType ~= Enum.UserInputType.MouseButton1
        and i.UserInputType ~= Enum.UserInputType.Touch then return end
        sizing = true
        sw, sh = frame.AbsoluteSize.X, frame.AbsoluteSize.Y
        sm = UIS:GetMouseLocation()
        paintGrip(true)
    end)
    self:HoldConn(frame, UIS.InputChanged:Connect(function(i)
        if not sizing or i.UserInputType ~= Enum.UserInputType.MouseMovement then return end
        local d = UIS:GetMouseLocation() - sm
        frame.Size = UDim2.fromOffset(
            math.clamp(sw + d.X, minW, maxW),
            math.clamp(sh + d.Y, minH, maxH))
        if onLive then pcall(onLive, frame.AbsoluteSize.X, frame.AbsoluteSize.Y) end
    end))
    self:HoldConn(frame, UIS.InputEnded:Connect(function(i)
        if not sizing then return end
        if i.UserInputType ~= Enum.UserInputType.MouseButton1
        and i.UserInputType ~= Enum.UserInputType.Touch then return end
        sizing = false
        paintGrip(false)
        if onDone then pcall(onDone, frame.AbsoluteSize.X, frame.AbsoluteSize.Y) end
    end))
    return frame
end
library.AddResizeEdges = library.AddEdgeHandles

-- The frame every window and panel is made of: layered halo, dark
-- edge, inner surface with a sheen, and an accent bloom top-left.
function library:BuildFrame(parent, w, h)
    local edge = new("Frame", {
        Name = "edge",
        BackgroundColor3 = self.edgeColor,
        BorderSizePixel = 0,
        Size = UDim2.fromOffset(w, h),
        ClipsDescendants = false,
        Active = true,
        ZIndex = 2,
    }, parent)
    corner(edge, RADIUS + 2)
    local h1, h2, h3 = halo(edge, self.accentColor)
    h1.Name = "edgeAccent"

    local bg = new("Frame", {
        Name = "background",
        AnchorPoint = Vector2.new(0.5, 0.5),
        Position = UDim2.new(0.5, 0, 0.5, 0),
        Size = UDim2.new(1, -2, 1, -2),
        -- white, because a UIGradient MULTIPLIES against BackgroundColor3:
        -- tint this dark and the gradient is crushed to black and invisible
        BackgroundColor3 = Color3.new(1, 1, 1),
        BorderSizePixel = 0,
        ClipsDescendants = true,
        ZIndex = 3,
    }, edge)
    corner(bg, RADIUS + 1)
    local inner = new("UIStroke", {
        Name = "innerStroke", Color = self.strokeColor,
        Transparency = 0.62, Thickness = 1,
        ApplyStrokeMode = Enum.ApplyStrokeMode.Border,
    }, bg)

    -- A real diagonal: deep red in the top-left corner driving down to
    -- black in the bottom-right. One gradient does the work, so the
    -- contrast is actually visible instead of two washes cancelling out.
    local bgGrad = new("UIGradient", { Name = "bgGradient", Rotation = 34 }, bg)
    local function paintBg()
        local a = self.accentColor
        bgGrad.Color = ColorSequence.new{
            ColorSequenceKeypoint.new(0.00, a:Lerp(Color3.new(0, 0, 0), 0.60)),
            ColorSequenceKeypoint.new(0.22, a:Lerp(Color3.new(0, 0, 0), 0.78)),
            ColorSequenceKeypoint.new(0.52, Color3.fromRGB(22, 11, 13)),
            ColorSequenceKeypoint.new(0.78, Color3.fromRGB(12, 9, 10)),
            ColorSequenceKeypoint.new(1.00, Color3.fromRGB(6, 6, 7)),
        }
    end
    paintBg()
    self:OnTheme(paintBg)

    -- a hard accent hairline down the left edge: cheap, and it reads as
    -- deliberate rather than decorative
    local spine = new("Frame", {
        Name = "spine",
        Size = UDim2.new(0, 2, 1, 0),
        BackgroundColor3 = self.accentColor,
        BorderSizePixel = 0, ZIndex = 4,
    }, bg)
    new("UIGradient", {
        Rotation = 90,
        Transparency = NumberSequence.new{
            NumberSequenceKeypoint.new(0.00, 0.1),
            NumberSequenceKeypoint.new(0.55, 0.6),
            NumberSequenceKeypoint.new(1.00, 1.0),
        },
    }, spine)
    self:OnTheme(function() spine.BackgroundColor3 = self.accentColor end)

    self:OnTheme(function()
        h1.Color, h2.Color, h3.Color = self.accentColor, self.accentColor, self.accentColor
        inner.Color = self.strokeColor
    end)
    return edge, bg
end

-- Header: picture, title, hairline rule with an accent falloff.
function library:BuildHeader(bg, titleText, height)
    height = height or HEADER_H
    local header = new("Frame", {
        Name = "header", Size = UDim2.new(1, 0, 0, height),
        BackgroundColor3 = Color3.new(1, 1, 1),   -- gradient supplies the colour
        BackgroundTransparency = 0.5,
        BorderSizePixel = 0, ZIndex = 5,
    }, bg)
    local hdrGrad = new("UIGradient", { Rotation = 90 }, header)
    local function paintHeader()
        local a = self.accentColor
        hdrGrad.Color = ColorSequence.new{
            ColorSequenceKeypoint.new(0.00, a:Lerp(Color3.fromRGB(26, 23, 27), 0.80)),
            ColorSequenceKeypoint.new(0.65, Color3.fromRGB(22, 20, 24)),
            ColorSequenceKeypoint.new(1.00, Color3.fromRGB(15, 14, 17)),
        }
    end
    paintHeader()
    self:OnTheme(paintHeader)

    local iconSize = math.min(height - 12, 24)
    local iconGlow = new("Frame", {
        Name = "iconGlow",
        Position = UDim2.fromOffset(9, (height - iconSize) / 2 - 2),
        Size = UDim2.fromOffset(iconSize + 4, iconSize + 4),
        BackgroundColor3 = self.accentColor,
        BackgroundTransparency = 0.82,
        BorderSizePixel = 0, ZIndex = 5,
    }, header)
    corner(iconGlow, 99)

    local icon = new("ImageLabel", {
        Name = "headerIcon",
        Position = UDim2.fromOffset(11, (height - iconSize) / 2),
        Size = UDim2.fromOffset(iconSize, iconSize),
        BackgroundColor3 = self.accentColor,
        BackgroundTransparency = 0,
        BorderSizePixel = 0, ZIndex = 6,
    }, header)
    corner(icon, 99)
    local id = self:LoadIcon(self.icon, "droidware_header.png")
    if id then
        icon.Image = id
        icon.BackgroundTransparency = 1
    end

    local title = new("TextLabel", {
        Name = "headerTitle",
        BackgroundTransparency = 1,
        Position = UDim2.fromOffset(13 + iconSize + 9, 0),
        Size = UDim2.new(1, -(iconSize + 70), 1, 0),
        Font = self.fontBold, TextSize = height >= 34 and 13 or 12,
        TextXAlignment = Enum.TextXAlignment.Left,
        TextColor3 = self.textColor,
        TextTruncate = Enum.TextTruncate.AtEnd,
        Text = tostring(titleText or ""), ZIndex = 6,
    }, header)

    local rule = new("Frame", {
        Name = "headerRule",
        Size = UDim2.new(1, 0, 0, 1),
        Position = UDim2.fromOffset(0, height),
        BackgroundColor3 = self.accentColor,
        BorderSizePixel = 0, ZIndex = 6,
    }, bg)
    new("UIGradient", {
        Color = ColorSequence.new{
            ColorSequenceKeypoint.new(0, self.accentColor),
            ColorSequenceKeypoint.new(1, self.strokeColor),
        },
        Transparency = NumberSequence.new{
            NumberSequenceKeypoint.new(0.00, 0.15),
            NumberSequenceKeypoint.new(0.45, 0.55),
            NumberSequenceKeypoint.new(1.00, 0.92),
        },
    }, rule)

    self:OnTheme(function()
        iconGlow.BackgroundColor3 = self.accentColor
        rule.BackgroundColor3     = self.accentColor
        if icon.Image == "" then icon.BackgroundColor3 = self.accentColor end
    end)
    return header, title, icon
end

-- ===========================================================
-- Controls, Linoria-style: dense rows, square checkboxes,
-- thin bars. Every row reserves a gutter for its control so a
-- long label truncates instead of sliding underneath it.
-- ===========================================================

local Groupbox = {}
Groupbox.__index = Groupbox

local function mkRow(gb, gutter, h)
    local row = new("Frame", {
        Name = "row", BackgroundTransparency = 1, BorderSizePixel = 0,
        Size = UDim2.new(1, 0, 0, h or ROW_H), ZIndex = 7,
    }, gb._body)
    local label = new("TextLabel", {
        Name = "rowLabel", BackgroundTransparency = 1,
        Position = UDim2.fromOffset(0, 0),
        Size = UDim2.new(1, -(gutter or 0), 1, 0),
        Font = library.font, TextSize = 12,
        TextXAlignment = Enum.TextXAlignment.Left,
        TextColor3 = library.textSecondary,
        TextTruncate = Enum.TextTruncate.AtEnd,
        ZIndex = 8,
    }, row)
    return row, label
end

-- ---------- toggle: square checkbox ----------
function Groupbox:NewToggle(text, default, callback)
    local state = default and true or false
    local row, label = mkRow(self, 24)
    label.Text     = tostring(text or "")
    label.Position = UDim2.fromOffset(22, 0)
    label.Size     = UDim2.new(1, -22, 1, 0)

    local box = new("Frame", {
        Name = "checkbox",
        AnchorPoint = Vector2.new(0, 0.5),
        Position = UDim2.new(0, 0, 0.5, 0),
        Size = UDim2.fromOffset(13, 13),
        BackgroundColor3 = library.inputColor,
        BorderSizePixel = 0, ZIndex = 8,
    }, row)
    corner(box, 3)
    local bStroke = outline(box, library.strokeColor, 0)

    local fill = new("Frame", {
        Name = "fill",
        AnchorPoint = Vector2.new(0.5, 0.5),
        Position = UDim2.new(0.5, 0, 0.5, 0),
        Size = UDim2.fromOffset(0, 0),
        BackgroundColor3 = library.accentColor,
        BorderSizePixel = 0, ZIndex = 9,
    }, box)
    corner(fill, 2)

    local hit = new("TextButton", {
        BackgroundTransparency = 1, Text = "", AutoButtonColor = false,
        Size = UDim2.new(1, 0, 1, 0), ZIndex = 10,
    }, row)

    local function paint(animate)
        local t = animate and 0.09 or 0
        tween(fill, t, { Size = state and UDim2.fromOffset(9, 9) or UDim2.fromOffset(0, 0) })
        fill.BackgroundColor3 = library.accentColor
        bStroke.Color = state and library.accentColor or library.strokeColor
        label.TextColor3 = state and library.textColor or library.textSecondary
    end
    paint(false)

    local F = {}
    function F:Set(v)
        state = v and true or false
        paint(true)
        if callback then pcall(callback, state) end
        return F
    end
    F.SetValue, F.SetState = F.Set, F.Set
    function F:Get() return state end
    F.GetValue = F.Get
    function F:Text(t) label.Text = tostring(t) return F end
    F.SetText = F.Text
    function F:Flag(name) library._flags[name] = F return F end

    hit.MouseButton1Click:Connect(function() F:Set(not state) end)
    hit.MouseEnter:Connect(function()
        if not state then label.TextColor3 = library.textColor end
        tween(bStroke, 0.1, { Transparency = 0 })
        tween(box, 0.1, { BackgroundColor3 = lerpColor(library.inputColor, library.accentSoft, 0.4) })
    end)
    hit.MouseLeave:Connect(function()
        if not state then label.TextColor3 = library.textSecondary end
        tween(bStroke, 0.14, { Transparency = state and 0 or 0.25 })
        tween(box, 0.14, { BackgroundColor3 = library.inputColor })
    end)
    library:OnTheme(function() paint(false) end)
    return F
end

-- ---------- slider: label over a thin bar, value inline ----------
function Groupbox:NewSlider(text, suffix, _a, _b, cfg, callback)
    cfg = cfg or {}
    local mn   = tonumber(cfg.min) or 0
    local mx   = tonumber(cfg.max) or 100
    local step = tonumber(cfg.step) or 1
    local val  = math.clamp(tonumber(cfg.default) or mn, mn, mx)
    suffix = tostring(suffix or "")

    local row = new("Frame", {
        Name = "sliderRow", BackgroundTransparency = 1,
        BorderSizePixel = 0, Size = UDim2.new(1, 0, 0, 32), ZIndex = 7,
    }, self._body)

    local label = new("TextLabel", {
        BackgroundTransparency = 1,
        Size = UDim2.new(1, -56, 0, 14),
        Font = library.font, TextSize = 12,
        TextXAlignment = Enum.TextXAlignment.Left,
        TextColor3 = library.textSecondary,
        TextTruncate = Enum.TextTruncate.AtEnd,
        Text = tostring(text or ""), ZIndex = 8,
    }, row)

    local valueLbl = new("TextLabel", {
        BackgroundTransparency = 1,
        AnchorPoint = Vector2.new(1, 0),
        Position = UDim2.new(1, 0, 0, 0),
        Size = UDim2.fromOffset(54, 14),
        Font = library.fontMed, TextSize = 12,
        TextXAlignment = Enum.TextXAlignment.Right,
        TextColor3 = library.accentColor, ZIndex = 8,
    }, row)

    local track = new("Frame", {
        Position = UDim2.fromOffset(0, 19),
        Size = UDim2.new(1, 0, 0, 9),
        BackgroundColor3 = library.inputColor,
        BorderSizePixel = 0, ZIndex = 8,
    }, row)
    corner(track, 3)
    outline(track, library.strokeColor, 0)

    local fill = new("Frame", {
        Size = UDim2.fromScale((val - mn) / math.max(mx - mn, 1e-6), 1),
        BackgroundColor3 = library.accentColor,
        BorderSizePixel = 0, ZIndex = 9,
    }, track)
    corner(fill, 3)
    sheen(fill,
        lerpColor(library.accentColor, Color3.new(1, 1, 1), 0.22),
        library.accentColor,
        lerpColor(library.accentColor, Color3.new(0, 0, 0), 0.25), 90)

    local function fmt(v)
        if step < 1 then return string.format("%.2f%s", v, suffix) end
        return string.format("%d%s", math.floor(v + 0.5), suffix)
    end
    local function paint()
        fill.Size     = UDim2.fromScale((val - mn) / math.max(mx - mn, 1e-6), 1)
        valueLbl.Text = fmt(val)
    end
    paint()

    local F = {}
    function F:Set(v, silent)
        v = tonumber(v) or val
        v = math.clamp(math.floor(v / step + 0.5) * step, mn, mx)
        if v == val then return F end
        val = v
        paint()
        if callback and not silent then pcall(callback, val) end
        return F
    end
    F.SetValue, F.Value = F.Set, F.Set
    function F:Get() return val end
    F.GetValue = F.Get
    function F:Text(t) label.Text = tostring(t) return F end
    function F:Flag(name) library._flags[name] = F return F end

    local hit = new("TextButton", {
        BackgroundTransparency = 1, Text = "", AutoButtonColor = false,
        Position = UDim2.fromOffset(0, 16), Size = UDim2.new(1, 0, 0, 15),
        ZIndex = 11,
    }, row)

    local dragging = false
    local function fromMouse()
        local x = mouseAbs().X
        local f = math.clamp((x - track.AbsolutePosition.X) / math.max(track.AbsoluteSize.X, 1), 0, 1)
        F:Set(mn + f * (mx - mn))
    end
    hit.InputBegan:Connect(function(i)
        if i.UserInputType == Enum.UserInputType.MouseButton1
        or i.UserInputType == Enum.UserInputType.Touch then dragging = true fromMouse() end
    end)
    hit.MouseEnter:Connect(function()
        tween(track, 0.1, { Size = UDim2.new(1, 0, 0, 11) })
        tween(label, 0.1, { TextColor3 = library.textColor })
    end)
    hit.MouseLeave:Connect(function()
        if dragging then return end
        tween(track, 0.14, { Size = UDim2.new(1, 0, 0, 9) })
        tween(label, 0.14, { TextColor3 = library.textSecondary })
    end)
    library:HoldConn(row, UIS.InputEnded:Connect(function(i)
        if i.UserInputType == Enum.UserInputType.MouseButton1
        or i.UserInputType == Enum.UserInputType.Touch then dragging = false end
    end))
    library:HoldConn(row, UIS.InputChanged:Connect(function(i)
        if dragging and (i.UserInputType == Enum.UserInputType.MouseMovement
        or i.UserInputType == Enum.UserInputType.Touch) then fromMouse() end
    end))
    library:OnTheme(function()
        fill.BackgroundColor3 = library.accentColor
        valueLbl.TextColor3   = library.accentColor
    end)
    return F
end

-- ---------- dropdown ----------
function Groupbox:NewSelector(text, default, options, callback)
    options = options or {}
    local current = default or options[1]

    local row = new("Frame", {
        Name = "selectorRow", BackgroundTransparency = 1,
        BorderSizePixel = 0, Size = UDim2.new(1, 0, 0, 32),
        ZIndex = 7, ClipsDescendants = false,
    }, self._body)

    local label = new("TextLabel", {
        BackgroundTransparency = 1, Size = UDim2.new(1, 0, 0, 14),
        Font = library.font, TextSize = 12,
        TextXAlignment = Enum.TextXAlignment.Left,
        TextColor3 = library.textSecondary,
        TextTruncate = Enum.TextTruncate.AtEnd,
        Text = tostring(text or ""), ZIndex = 8,
    }, row)

    local box = new("TextButton", {
        Position = UDim2.fromOffset(0, 16),
        Size = UDim2.new(1, 0, 0, 16),
        BackgroundColor3 = library.inputColor,
        BorderSizePixel = 0, AutoButtonColor = false,
        Font = library.fontMed, TextSize = 11,
        TextColor3 = library.textColor,
        TextXAlignment = Enum.TextXAlignment.Left,
        Text = "  " .. tostring(current or ""), ZIndex = 8,
    }, row)
    corner(box, 3)
    local bStroke = outline(box, library.strokeColor, 0.3)
    box.MouseEnter:Connect(function()
        tween(bStroke, 0.1, { Transparency = 0 })
        tween(box, 0.1, { BackgroundColor3 = lerpColor(library.inputColor, library.accentSoft, 0.3) })
    end)
    box.MouseLeave:Connect(function()
        tween(bStroke, 0.14, { Transparency = 0.3 })
        tween(box, 0.14, { BackgroundColor3 = library.inputColor })
    end)

    new("TextLabel", {
        BackgroundTransparency = 1,
        AnchorPoint = Vector2.new(1, 0.5),
        Position = UDim2.new(1, -7, 0.5, 0),
        Size = UDim2.fromOffset(10, 10),
        Font = library.fontBold, TextSize = 9,
        TextColor3 = library.textMuted, Text = "v", ZIndex = 9,
    }, box)

    -- the menu floats above everything on its own layer
    -- the menu must not live inside the groupbox, which clips its children.
    -- Prefer the window overlay; fall back to whatever ScreenGui we are in.
    local menuHome = library._overlay
        or row:FindFirstAncestorWhichIsA("ScreenGui")
        or row
    local menu = new("ScrollingFrame", {
        Name = "selectorMenu", Visible = false,
        BackgroundColor3 = library.surfaceColor,
        BorderSizePixel = 0, ZIndex = 200,
        ClipsDescendants = true,
        Active = true,
        ScrollingDirection = Enum.ScrollingDirection.Y,
        ScrollBarThickness = 3,
        ScrollBarImageColor3 = library.accentColor,
        ScrollBarImageTransparency = 0.25,
        CanvasSize = UDim2.new(),
        AutomaticCanvasSize = Enum.AutomaticSize.Y,
        VerticalScrollBarInset = Enum.ScrollBarInset.ScrollBar,
        ElasticBehavior = Enum.ElasticBehavior.Never,
    }, menuHome)
    corner(menu, 3)
    outline(menu, library.accentColor, 0.15)
    local menuList = list(menu, 1)
    padding(menu, 3, 3, 3, 3)

    local F = {}
    local backdrop
    local function close()
        menu.Visible = false
        if backdrop then backdrop.Visible = false end
        if library._openMenu == close then library._openMenu = nil end
    end
    local function rebuild()
        for _, c in ipairs(menu:GetChildren()) do
            if c:IsA("TextButton") then c:Destroy() end
        end
        for _, opt in ipairs(options) do
            local b = new("TextButton", {
                Size = UDim2.new(1, 0, 0, 19),
                BackgroundColor3 = library.bgColor,
                BackgroundTransparency = (opt == current) and 0.2 or 1,
                BorderSizePixel = 0, AutoButtonColor = false,
                Font = library.font, TextSize = 11,
                TextColor3 = (opt == current) and library.accentColor or library.textSecondary,
                TextXAlignment = Enum.TextXAlignment.Left,
                Text = "  " .. tostring(opt), ZIndex = 201,
            }, menu)
            corner(b, 4)
            b.MouseEnter:Connect(function() b.BackgroundTransparency = 0.35 end)
            b.MouseLeave:Connect(function()
                b.BackgroundTransparency = (opt == current) and 0.2 or 1
            end)
            b.MouseButton1Click:Connect(function()
                current = opt
                box.Text = "  " .. tostring(opt)
                close()
                rebuild()
                if callback then pcall(callback, opt) end
            end)
        end
        local rows    = #options
        local maxRows  = tonumber(library.dropdownMaxRows) or 10
        local shown    = math.min(rows, maxRows)
        if shown < 1 then shown = 1 end
        menu.CanvasPosition = Vector2.new(0, 0)
        menu.Size = UDim2.fromOffset(
            math.max(box.AbsoluteSize.X, 90),
            shown * 20 + 6)
    end

    box.MouseButton1Click:Connect(function()
        if menu.Visible then close() return end
        rebuild()
        -- open upward when there is not enough room below, otherwise a
        -- dropdown near the bottom of the window renders off screen
        local menuH = menu.Size.Y.Offset
        local bp, bs = box.AbsolutePosition, box.AbsoluteSize
        local viewH  = workspace.CurrentCamera
            and workspace.CurrentCamera.ViewportSize.Y or 1080
        local below  = bp.Y + bs.Y + 3
        local above  = bp.Y - menuH - 3
        local y = below
        if below + menuH > viewH - 8 and above >= 8 then y = above end
        menu.Position = UDim2.fromOffset(bp.X, y)
        -- only one menu open at a time
        if library._openMenu and library._openMenu ~= close then
            pcall(library._openMenu)
        end
        library._openMenu = close
        backdrop.Visible = true
        menu.Visible     = true
    end)
    -- A transparent full-screen button sits UNDER the menu and above
    -- everything else. Clicking off the menu hits it and closes; clicking
    -- an option hits the option, because the menu is drawn above it.
    -- No mouse coordinates involved, so no inset to get wrong.
    backdrop = new("TextButton", {
        Name = "selectorBackdrop",
        BackgroundTransparency = 1,
        Text = "", AutoButtonColor = false,
        Size = UDim2.new(1, 0, 1, 0),
        Visible = false, ZIndex = 199,
    }, menuHome)
    backdrop.MouseButton1Click:Connect(function() close() end)

    function F:SetOption(v)
        current = v
        box.Text = "  " .. tostring(v or "")
        if callback then pcall(callback, v) end
        return F
    end
    F.SetValue, F.Set, F.Select = F.SetOption, F.SetOption, F.SetOption
    function F:GetOption() return current end
    F.GetValue = F.GetOption
    function F:AddOption(v)
        options[#options + 1] = v
        if menu.Visible then rebuild() end
        return F
    end
    function F:SetOptions(t)
        options = t or {}
        if current ~= nil then
            local still = false
            for _, o in ipairs(options) do
                if o == current then still = true break end
            end
            if not still then
                current = options[1]
                box.Text = "  " .. tostring(current or "")
            end
        end
        if menu.Visible then rebuild() end
        return F
    end
    F.SetValues = F.SetOptions
    function F:Text(t) label.Text = tostring(t) return F end
    function F:Flag(name) library._flags[name] = F return F end
    library:OnTheme(function() bStroke.Color = library.strokeColor end)
    self:_grow()
    return F
end

-- ---------- colour picker ----------
function Groupbox:NewColorPicker(text, default, callback)
    local col = (typeof(default) == "Color3") and default or Color3.fromRGB(255, 255, 255)
    local row, label = mkRow(self, 44)
    label.Text = tostring(text or "")

    local swatch = new("TextButton", {
        AnchorPoint = Vector2.new(1, 0.5),
        Position = UDim2.new(1, 0, 0.5, 0),
        Size = UDim2.fromOffset(34, 16),
        BackgroundColor3 = col, BorderSizePixel = 0,
        AutoButtonColor = false, Text = "", ZIndex = 9,
    }, row)
    corner(swatch, 3)
    local swStroke = outline(swatch, library.strokeColor, 0.2)
    swatch.MouseEnter:Connect(function() tween(swStroke, 0.1, { Transparency = 0 }) end)
    swatch.MouseLeave:Connect(function() tween(swStroke, 0.14, { Transparency = 0.2 }) end)

    local home = library._overlay
        or row:FindFirstAncestorWhichIsA("ScreenGui")
        or row

    -- closes the panel when you click anywhere else, exactly like the
    -- selector menu does. without this the panel never goes away and a
    -- second picker just stacks on top of the first.
    local backdrop = new("TextButton", {
        Name = "colorBackdrop", Visible = false,
        BackgroundTransparency = 1, Text = "", AutoButtonColor = false,
        Size = UDim2.new(1, 0, 1, 0), ZIndex = 198,
    }, home)

    local panel = new("Frame", {
        Name = "colorPanel", Visible = false,
        Size = UDim2.fromOffset(188, 176),
        BackgroundColor3 = library.surfaceColor, BorderSizePixel = 0,
        ZIndex = 200,
    }, home)
    corner(panel, 4)
    outline(panel, library.accentColor, 0.15)

    local sv = new("TextButton", {
        Position = UDim2.fromOffset(8, 8), Size = UDim2.fromOffset(172, 96),
        BackgroundColor3 = Color3.fromHSV(select(1, col:ToHSV()), 1, 1),
        BorderSizePixel = 0, AutoButtonColor = false, Text = "", ZIndex = 201,
    }, panel)
    corner(sv, 4)
    local white = new("Frame", {
        Size = UDim2.new(1, 0, 1, 0), BackgroundColor3 = Color3.new(1, 1, 1),
        BorderSizePixel = 0, ZIndex = 202, Active = false,
    }, sv)
    corner(white, 4)
    new("UIGradient", {
        Transparency = NumberSequence.new{
            NumberSequenceKeypoint.new(0, 0), NumberSequenceKeypoint.new(1, 1) },
    }, white)
    local dark = new("Frame", {
        Size = UDim2.new(1, 0, 1, 0), BackgroundColor3 = Color3.new(0, 0, 0),
        BorderSizePixel = 0, ZIndex = 203, Active = false,
    }, sv)
    corner(dark, 4)
    new("UIGradient", {
        Rotation = 90,
        Transparency = NumberSequence.new{
            NumberSequenceKeypoint.new(0, 1), NumberSequenceKeypoint.new(1, 0) },
    }, dark)
    local svDot = new("Frame", {
        AnchorPoint = Vector2.new(0.5, 0.5), Size = UDim2.fromOffset(7, 7),
        BackgroundColor3 = Color3.new(1, 1, 1), BorderSizePixel = 0,
        ZIndex = 205, Active = false,
    }, sv)
    corner(svDot, 4)
    outline(svDot, Color3.new(0, 0, 0), 0.3)

    local hueBar = new("TextButton", {
        Position = UDim2.fromOffset(8, 112), Size = UDim2.fromOffset(172, 14),
        BorderSizePixel = 0, AutoButtonColor = false, Text = "", ZIndex = 201,
        BackgroundColor3 = Color3.new(1, 1, 1),
    }, panel)
    corner(hueBar, 4)
    new("UIGradient", {
        Color = ColorSequence.new{
            ColorSequenceKeypoint.new(0.00, Color3.fromRGB(255,0,0)),
            ColorSequenceKeypoint.new(0.17, Color3.fromRGB(255,255,0)),
            ColorSequenceKeypoint.new(0.33, Color3.fromRGB(0,255,0)),
            ColorSequenceKeypoint.new(0.50, Color3.fromRGB(0,255,255)),
            ColorSequenceKeypoint.new(0.67, Color3.fromRGB(0,0,255)),
            ColorSequenceKeypoint.new(0.83, Color3.fromRGB(255,0,255)),
            ColorSequenceKeypoint.new(1.00, Color3.fromRGB(255,0,0)),
        },
    }, hueBar)
    local hueDot = new("Frame", {
        AnchorPoint = Vector2.new(0.5, 0.5), Size = UDim2.fromOffset(4, 18),
        BackgroundColor3 = Color3.new(1, 1, 1), BorderSizePixel = 0,
        ZIndex = 205, Active = false,
    }, hueBar)
    corner(hueDot, 2)
    outline(hueDot, Color3.new(0, 0, 0), 0.3)

    local preview = new("Frame", {
        Position = UDim2.fromOffset(8, 134), Size = UDim2.fromOffset(44, 32),
        BackgroundColor3 = col, BorderSizePixel = 0, ZIndex = 201,
    }, panel)
    corner(preview, 3)
    outline(preview, library.strokeColor, 0.3)

    local hex = new("TextBox", {
        Position = UDim2.fromOffset(58, 134), Size = UDim2.fromOffset(122, 32),
        BackgroundColor3 = library.inputColor, BorderSizePixel = 0,
        Font = library.fontMed, TextSize = 12, ZIndex = 201,
        TextColor3 = library.textColor, ClearTextOnFocus = false,
        Text = string.format("#%02X%02X%02X",
            math.floor(col.R * 255 + 0.5),
            math.floor(col.G * 255 + 0.5),
            math.floor(col.B * 255 + 0.5)),
    }, panel)
    corner(hex, 3)
    outline(hex, library.strokeColor, 0.35)

    local h, sat, v = col:ToHSV()
    local F = {}

    local function apply(fire)
        col = Color3.fromHSV(h, sat, v)
        swatch.BackgroundColor3 = col
        preview.BackgroundColor3 = col
        sv.BackgroundColor3 = Color3.fromHSV(h, 1, 1)
        svDot.Position  = UDim2.new(sat, 0, 1 - v, 0)
        hueDot.Position = UDim2.new(h, 0, 0.5, 0)
        if not hex:IsFocused() then
            hex.Text = string.format("#%02X%02X%02X",
                math.floor(col.R * 255 + 0.5),
                math.floor(col.G * 255 + 0.5),
                math.floor(col.B * 255 + 0.5))
        end
        if fire and callback then pcall(callback, col) end
    end

    local dragSV, dragHue = false, false
    local function pickSV()
        local m = mouseAbs()
        sat = math.clamp((m.X - sv.AbsolutePosition.X) / math.max(sv.AbsoluteSize.X, 1), 0, 1)
        v   = 1 - math.clamp((m.Y - sv.AbsolutePosition.Y) / math.max(sv.AbsoluteSize.Y, 1), 0, 1)
        apply(true)
    end
    local function pickHue()
        local m = mouseAbs()
        h = math.clamp((m.X - hueBar.AbsolutePosition.X) / math.max(hueBar.AbsoluteSize.X, 1), 0, 1)
        apply(true)
    end

    -- both a click and a drag must work: InputBegan alone misses the case
    -- where the press lands and the pointer never moves.
    sv.MouseButton1Down:Connect(function() dragSV = true pickSV() end)
    hueBar.MouseButton1Down:Connect(function() dragHue = true pickHue() end)
    sv.InputBegan:Connect(function(i)
        if i.UserInputType == Enum.UserInputType.MouseButton1 then dragSV = true pickSV() end
    end)
    hueBar.InputBegan:Connect(function(i)
        if i.UserInputType == Enum.UserInputType.MouseButton1 then dragHue = true pickHue() end
    end)
    library:HoldConn(row, UIS.InputEnded:Connect(function(i)
        if i.UserInputType == Enum.UserInputType.MouseButton1 then dragSV, dragHue = false, false end
    end))
    library:HoldConn(row, UIS.InputChanged:Connect(function(i)
        if i.UserInputType ~= Enum.UserInputType.MouseMovement then return end
        if dragSV then pickSV() elseif dragHue then pickHue() end
    end))

    hex.FocusLost:Connect(function()
        local t = tostring(hex.Text):gsub("#", ""):gsub("%s", "")
        if #t == 6 and tonumber(t, 16) then
            local n = tonumber(t, 16)
            local c = Color3.fromRGB(
                math.floor(n / 65536) % 256,
                math.floor(n / 256) % 256,
                n % 256)
            h, sat, v = c:ToHSV()
            apply(true)
        else
            apply(false)
        end
    end)

    local function close()
        panel.Visible = false
        backdrop.Visible = false
        if library._openMenu == close then library._openMenu = nil end
    end
    backdrop.MouseButton1Click:Connect(close)

    swatch.MouseButton1Click:Connect(function()
        if panel.Visible then close() return end
        -- only one floating panel at a time, same rule the selector uses
        if library._openMenu then pcall(library._openMenu) end
        library._openMenu = close
        local sp    = swatch.AbsolutePosition
        local ph    = panel.AbsoluteSize.Y
        local pw    = panel.AbsoluteSize.X
        local cam   = workspace.CurrentCamera
        local viewX = cam and cam.ViewportSize.X or 1920
        local viewY = cam and cam.ViewportSize.Y or 1080
        local hostPos = (home:IsA("Frame") and home.AbsolutePosition) or Vector2.new(0, 0)
        local x = math.clamp(sp.X - pw + 34, 8, math.max(8, viewX - pw - 8))
        local y = sp.Y + 22
        if y + ph > viewY - 8 then y = math.max(8, sp.Y - ph - 6) end
        panel.Position   = UDim2.fromOffset(x - hostPos.X, y - hostPos.Y)
        backdrop.Visible = true
        panel.Visible    = true
        apply(false)
    end)

    function F:SetColor(c)
        if typeof(c) ~= "Color3" then return F end
        h, sat, v = c:ToHSV()
        apply(false)
        return F
    end
    F.SetValue, F.Set, F.Color = F.SetColor, F.SetColor, F.SetColor
    function F:GetColor() return col end
    F.GetValue = F.GetColor
    function F:Flag(name) library._flags[name] = F return F end
    apply(false)
    self:_grow()
    return F
end

function Groupbox:NewKeypicker(text, default, callback)
    local key = default
    if typeof(key) == "string" then key = Enum.KeyCode[key] end
    local row, label = mkRow(self, 62)
    label.Text = tostring(text or "")

    local function nameOf(k)
        if typeof(k) == "EnumItem" then return k.Name end
        if type(k) == "string" and k ~= "" then return k end
        return "None"
    end

    local listening = false

    local btn = new("TextButton", {
        AnchorPoint = Vector2.new(1, 0.5),
        Position = UDim2.new(1, 0, 0.5, 0),
        Size = UDim2.fromOffset(56, 16),
        BackgroundColor3 = library.inputColor,
        BorderSizePixel = 0, AutoButtonColor = false,
        Font = library.fontMed, TextSize = 10,
        TextColor3 = library.textSecondary,
        Text = nameOf(key), ZIndex = 9,
    }, row)
    corner(btn, 3)
    local bs = outline(btn, library.strokeColor, 0.3)
    btn.MouseEnter:Connect(function()
        if not listening then tween(bs, 0.1, { Transparency = 0 }) end
    end)
    btn.MouseLeave:Connect(function()
        if not listening then tween(bs, 0.14, { Transparency = 0.3 }) end
    end)

    local F = {}
    function F:SetKey(k)
        if typeof(k) == "string" then k = Enum.KeyCode[k] end
        key = k
        btn.Text = nameOf(key)
        if callback then pcall(callback, key) end
        return F
    end
    F.SetValue, F.Set = F.SetKey, F.SetKey
    function F:GetKey() return key end
    F.GetValue = F.GetKey
    function F:Text(t) label.Text = tostring(t) return F end
    function F:Flag(name) library._flags[name] = F return F end

    btn.MouseButton1Click:Connect(function()
        if listening then return end
        listening = true
        btn.Text = "..."
        bs.Color, bs.Transparency = library.accentColor, 0.1
    end)
    library:HoldConn(row, UIS.InputBegan:Connect(function(i, gpe)
        if not listening then return end
        if i.UserInputType == Enum.UserInputType.Keyboard then
            listening = false
            bs.Color, bs.Transparency = library.strokeColor, 0.45
            if i.KeyCode == Enum.KeyCode.Backspace or i.KeyCode == Enum.KeyCode.Delete then
                F:SetKey(nil)
            else
                F:SetKey(i.KeyCode)
            end
        end
    end))
    self:_grow()
    return F
end

-- ---------- textbox ----------
function Groupbox:NewTextbox(text, default, placeholder, _a, _b, _c, _d, callback)
    local row = new("Frame", {
        Name = "textboxRow", BackgroundTransparency = 1,
        BorderSizePixel = 0, Size = UDim2.new(1, 0, 0, 34), ZIndex = 7,
    }, self._body)

    new("TextLabel", {
        BackgroundTransparency = 1, Size = UDim2.new(1, 0, 0, 16),
        Font = library.font, TextSize = 12,
        TextXAlignment = Enum.TextXAlignment.Left,
        TextColor3 = library.textSecondary,
        TextTruncate = Enum.TextTruncate.AtEnd,
        Text = tostring(text or ""), ZIndex = 8,
    }, row)

    local box = new("TextBox", {
        Position = UDim2.fromOffset(0, 16),
        Size = UDim2.new(1, 0, 0, 18),
        BackgroundColor3 = library.inputColor,
        BorderSizePixel = 0, ClearTextOnFocus = false,
        Font = library.font, TextSize = 11,
        TextColor3 = library.textColor,
        PlaceholderText = tostring(placeholder or ""),
        PlaceholderColor3 = library.textMuted,
        TextXAlignment = Enum.TextXAlignment.Left,
        Text = tostring(default or ""), ZIndex = 8,
    }, row)
    corner(box, 3)
    local bs = outline(box, library.strokeColor, 0)
    padding(box, 8, 8, 0, 0)

    box.MouseEnter:Connect(function()
        if not box:IsFocused() then tween(bs, 0.1, { Transparency = 0.15 }) end
    end)
    box.MouseLeave:Connect(function()
        if not box:IsFocused() then tween(bs, 0.14, { Transparency = 0.45 }) end
    end)
    box.Focused:Connect(function() bs.Color, bs.Transparency = library.accentColor, 0.2 end)
    box.FocusLost:Connect(function()
        bs.Color, bs.Transparency = library.strokeColor, 0.45
        if callback then pcall(callback, box.Text) end
    end)

    local F = {}
    function F:SetValue(v) box.Text = tostring(v or "") return F end
    F.Set, F.Text = F.SetValue, F.SetValue
    function F:GetValue() return box.Text end
    function F:Flag(name) library._flags[name] = F return F end
    self:_grow()
    return F
end

-- ---------- button ----------
function Groupbox:NewButton(text, callback)
    local outer = new("TextButton", {
        Name = "button",
        Size = UDim2.new(1, 0, 0, 22),
        BackgroundColor3 = library.accentSoft,
        BorderSizePixel = 0, AutoButtonColor = false,
        Text = "", ZIndex = 7,
    }, self._body)
    corner(outer, 3)

    local inner = new("Frame", {
        AnchorPoint = Vector2.new(0.5, 0.5),
        Position = UDim2.new(0.5, 0, 0.5, 0),
        Size = UDim2.new(1, -2, 1, -2),
        BackgroundColor3 = library.surfaceColor,
        BorderSizePixel = 0, ZIndex = 8,
    }, outer)
    corner(inner, 2)

    local lbl = new("TextLabel", {
        BackgroundTransparency = 1, Size = UDim2.new(1, -10, 1, 0),
        Position = UDim2.fromOffset(5, 0),
        Font = library.fontMed, TextSize = 12,
        TextColor3 = library.accentColor,
        TextTruncate = Enum.TextTruncate.AtEnd,
        Text = tostring(text or ""), ZIndex = 9,
    }, inner)

    outer.MouseEnter:Connect(function()
        tween(inner, 0.1, { BackgroundColor3 = lerpColor(library.surfaceColor, library.accentSoft, 0.55) })
        tween(lbl,   0.1, { TextSize = 13 })
    end)
    outer.MouseLeave:Connect(function()
        tween(inner, 0.14, { BackgroundColor3 = library.surfaceColor })
        tween(lbl,   0.14, { TextSize = 12 })
    end)
    if callback then outer.MouseButton1Click:Connect(function() pcall(callback) end) end

    local F = {}
    function F:Text(t) lbl.Text = tostring(t) return F end
    F.SetText, F.SetName = F.Text, F.Text
    function F:Flag(name) library._flags[name] = F return F end
    library:OnTheme(function()
        outer.BackgroundColor3 = library.accentSoft
        lbl.TextColor3         = library.accentColor
    end)
    self:_grow()
    return F
end

-- ---------- label ----------
function Groupbox:NewLabel(text)
    local lbl = new("TextLabel", {
        Name = "label", BackgroundTransparency = 1,
        Size = UDim2.new(1, 0, 0, 14),
        AutomaticSize = Enum.AutomaticSize.Y,
        Font = library.font, TextSize = 11,
        TextColor3 = library.textMuted,
        TextXAlignment = Enum.TextXAlignment.Left,
        TextYAlignment = Enum.TextYAlignment.Top,
        TextWrapped = true,
        Text = tostring(text or ""), ZIndex = 7,
    }, self._body)

    local F = {}
    function F:Text(t) lbl.Text = tostring(t) return F end
    F.SetText = F.Text
    function F:GetText() return lbl.Text end
    function F:Flag(name) library._flags[name] = F return F end
    self:_grow()
    return F
end

-- ---------- separator ----------
function Groupbox:NewSeperator(text)
    local holder = new("Frame", {
        Name = "separator", BackgroundTransparency = 1,
        BorderSizePixel = 0, Size = UDim2.new(1, 0, 0, text and 16 or 7), ZIndex = 7,
    }, self._body)
    local line = new("Frame", {
        AnchorPoint = Vector2.new(0, 0.5),
        Position = UDim2.new(0, 0, 0.5, 0),
        Size = UDim2.new(1, 0, 0, 1),
        BackgroundColor3 = library.strokeColor,
        BackgroundTransparency = 0.35,
        BorderSizePixel = 0, ZIndex = 7,
    }, holder)
    if text then
        line.Size = UDim2.new(1, 0, 0, 1)
        new("TextLabel", {
            BackgroundColor3 = library.bgColor,
            Size = UDim2.new(0, 0, 0, 14),
            AutomaticSize = Enum.AutomaticSize.X,
            Position = UDim2.new(0, 6, 0.5, 0),
            AnchorPoint = Vector2.new(0, 0.5),
            Font = library.fontMed, TextSize = 9,
            TextColor3 = library.textMuted,
            Text = "  " .. string.upper(tostring(text)) .. "  ", ZIndex = 8,
        }, holder)
    end
    self:_grow()
    local F = {}
    function F:Text() return F end
    return F
end
Groupbox.NewSeparator = Groupbox.NewSeperator
Groupbox.NewDivider   = Groupbox.NewSeperator

-- ===========================================================
-- Window, tabs, and the column grid.
--
-- Columns are not a fixed count. The content area fits as many
-- COL_MIN-wide columns as it can hold, so widening the window
-- adds a column and narrowing removes one -- labels never get
-- squeezed below the width they need.
-- ===========================================================

function Groupbox:_grow() end   -- AutomaticSize does the work

local function newGroupbox(column, title)
    local gb = setmetatable({}, Groupbox)

    local frame = new("Frame", {
        Name = "groupbox",
        BackgroundColor3 = Color3.new(1, 1, 1),   -- gradient supplies the colour
        BorderSizePixel = 0,
        Size = UDim2.new(1, 0, 0, 0),
        AutomaticSize = Enum.AutomaticSize.Y,
        ZIndex = 6,
    }, column)
    corner(frame, RADIUS)
    local gbStroke = new("UIStroke", {
        Color = library.strokeColor, Transparency = 0.45, Thickness = 1,
        ApplyStrokeMode = Enum.ApplyStrokeMode.Border,
    }, frame)
    local gbGlow = new("UIStroke", {
        Color = library.accentColor, Transparency = 1, Thickness = 2,
        ApplyStrokeMode = Enum.ApplyStrokeMode.Border,
    }, frame)
    sheen(frame,
        Color3.fromRGB(31, 28, 34),
        Color3.fromRGB(25, 23, 28),
        Color3.fromRGB(21, 19, 24))

    -- hover lifts the box out of the page a touch
    local hover = new("TextButton", {
        BackgroundTransparency = 1, Text = "", AutoButtonColor = false,
        Size = UDim2.new(1, 0, 1, 0), ZIndex = 5, Active = false,
    }, frame)
    hover.MouseEnter:Connect(function()
        tween(gbStroke, 0.12, { Transparency = 0.2 })
        tween(gbGlow,   0.12, { Transparency = 0.82 })
    end)
    hover.MouseLeave:Connect(function()
        tween(gbStroke, 0.16, { Transparency = 0.45 })
        tween(gbGlow,   0.16, { Transparency = 1 })
    end)

    if title and title ~= "" then
        local tick = new("Frame", {
            Name = "gbTick",
            Position = UDim2.fromOffset(10, 8),
            Size = UDim2.fromOffset(2, 9),
            BackgroundColor3 = library.accentColor,
            BorderSizePixel = 0, ZIndex = 8,
        }, frame)
        corner(tick, 1)
        new("TextLabel", {
            Name = "gbTitle", BackgroundTransparency = 1,
            Position = UDim2.fromOffset(18, 4),
            Size = UDim2.new(1, -26, 0, 14),
            Font = library.fontBold, TextSize = 11,
            TextColor3 = library.textColor,
            TextXAlignment = Enum.TextXAlignment.Left,
            TextTruncate = Enum.TextTruncate.AtEnd,
            Text = string.upper(tostring(title)), ZIndex = 7,
        }, frame)
        library:OnTheme(function() tick.BackgroundColor3 = library.accentColor end)
    end

    local body = new("Frame", {
        Name = "gbBody", BackgroundTransparency = 1, BorderSizePixel = 0,
        Position = UDim2.fromOffset(0, title and 22 or 6),
        Size = UDim2.new(1, 0, 0, 0),
        AutomaticSize = Enum.AutomaticSize.Y, ZIndex = 7,
    }, frame)
    list(body, 5)
    padding(body, 9, 9, 0, 9)

    -- Collapse / expand. Sections start closed so a tab opens as a short
    -- list of headings rather than a wall of controls.
    if title and title ~= "" then
        local open = false

        local sign = new("TextButton", {
            Name = "gbToggle",
            AnchorPoint = Vector2.new(1, 0),
            Position = UDim2.new(1, -8, 0, 3),
            Size = UDim2.fromOffset(16, 16),
            BackgroundColor3 = library.inputColor,
            BorderSizePixel = 0, AutoButtonColor = false,
            Font = library.fontBold, TextSize = 13,
            TextColor3 = library.accentColor,
            Text = "+", ZIndex = 9,
        }, frame)
        corner(sign, 3)
        local signStroke = new("UIStroke", {
            Color = library.strokeColor, Transparency = 0.4, Thickness = 1,
            ApplyStrokeMode = Enum.ApplyStrokeMode.Border,
        }, sign)

        -- a full-width invisible button over the heading, so the whole
        -- title row toggles rather than just the little square
        local headHit = new("TextButton", {
            Name = "gbHeadHit",
            Position = UDim2.fromOffset(0, 0),
            Size = UDim2.new(1, 0, 0, 22),
            BackgroundTransparency = 1, Text = "", AutoButtonColor = false,
            ZIndex = 8,
        }, frame)

        local function apply(animate)
            body.Visible = open
            sign.Text    = open and "-" or "+"
            if open then
                body.AutomaticSize = Enum.AutomaticSize.Y
                frame.AutomaticSize = Enum.AutomaticSize.Y
            else
                frame.AutomaticSize = Enum.AutomaticSize.None
                frame.Size = UDim2.new(1, 0, 0, 28)
            end
            local t = animate and 0.1 or 0
            tween(sign, t, {
                BackgroundColor3 = open and library.accentSoft or library.inputColor,
            })
        end
        apply(false)

        local function flip()
            open = not open
            apply(true)
        end
        sign.MouseButton1Click:Connect(flip)
        headHit.MouseButton1Click:Connect(flip)
        headHit.MouseEnter:Connect(function()
            tween(signStroke, 0.1, { Transparency = 0 })
        end)
        headHit.MouseLeave:Connect(function()
            tween(signStroke, 0.14, { Transparency = 0.4 })
        end)

        gb._setOpen = function(_, v) open = v and true or false apply(true) end
        gb._isOpen  = function() return open end
        library:OnTheme(function()
            sign.TextColor3 = library.accentColor
            apply(false)
        end)
    end

    gb._frame, gb._body = frame, body
    library:OnTheme(function()
        gbStroke.Color = library.strokeColor
        gbGlow.Color   = library.accentColor
        local t = frame:FindFirstChild("gbTitle")
        if t then t.TextColor3 = library.textColor end
    end)
    return gb
end

function library:Init(toggleKey)
    toggleKey = toggleKey or Enum.KeyCode.P
    if typeof(toggleKey) == "string" then toggleKey = Enum.KeyCode[toggleKey] end

    for _, g in ipairs(self._screenGuis) do pcall(function() g:Destroy() end) end
    table.clear(self._screenGuis)
    for _, c in ipairs(self._connections) do pcall(function() c:Disconnect() end) end
    table.clear(self._connections)

    local sg = new("ScreenGui", {
        Name = "droidware", ResetOnSpawn = false, IgnoreGuiInset = true,
        ZIndexBehavior = Enum.ZIndexBehavior.Sibling, DisplayOrder = 9999,
    }, host())
    self._screenGuis[#self._screenGuis + 1] = sg
    self._gui = sg

    -- dropdown menus and colour panels render here, above everything
    self._overlay = new("Frame", {
        Name = "overlay", BackgroundTransparency = 1,
        Size = UDim2.new(1, 0, 1, 0), ZIndex = 190,
    }, sg)

    local W = math.clamp(tonumber(self.windowWidth) or 1060, MIN_W, MAX_W)
    local H = math.clamp(tonumber(self.windowHeight) or 620, MIN_H, MAX_H)

    local edge, bg = self:BuildFrame(sg, W, H)
    edge.AnchorPoint = Vector2.new(0.5, 0.5)
    edge.Position    = UDim2.new(0.5, 0, 0.5, 0)
    self._window = edge

    local header, titleLbl = self:BuildHeader(bg, self.title, HEADER_H)
    titleLbl.TextSize = 15
    self:MakeDraggable(edge, header)

    -- ---------- sidebar ----------
    local nav = new("Frame", {
        Name = "nav",
        Position = UDim2.fromOffset(PAD, HEADER_H + PAD),
        Size = UDim2.new(0, NAV_W, 1, -(HEADER_H + PAD * 2)),
        BackgroundColor3 = Color3.new(1, 1, 1),
        BorderSizePixel = 0, ZIndex = 5,
    }, bg)
    corner(nav, RADIUS)
    new("UIStroke", {
        Color = self.strokeColor, Transparency = 0.5, Thickness = 1,
        ApplyStrokeMode = Enum.ApplyStrokeMode.Border,
    }, nav)
    sheen(nav,
        Color3.fromRGB(28, 25, 31),
        Color3.fromRGB(22, 20, 25),
        Color3.fromRGB(18, 17, 21))

    -- profile card, pinned to the bottom of the sidebar
    local CARD_H = 58
    local card = new("Frame", {
        Name = "profileCard",
        AnchorPoint = Vector2.new(0.5, 1),
        Position = UDim2.new(0.5, 0, 1, -8),
        Size = UDim2.new(1, -16, 0, CARD_H),
        BackgroundColor3 = Color3.new(1, 1, 1),
        BorderSizePixel = 0, ZIndex = 7,
    }, nav)
    corner(card, RADIUS)
    new("UIStroke", {
        Color = self.strokeColor, Transparency = 0.45, Thickness = 1,
        ApplyStrokeMode = Enum.ApplyStrokeMode.Border,
    }, card)
    sheen(card,
        Color3.fromRGB(38, 31, 42),
        Color3.fromRGB(27, 24, 30),
        Color3.fromRGB(21, 19, 24))

    local avRing = new("Frame", {
        Name = "avatarRing",
        Position = UDim2.fromOffset(8, (CARD_H - 40) / 2),
        Size = UDim2.fromOffset(40, 40),
        BackgroundColor3 = self.accentColor,
        BackgroundTransparency = 0.75,
        BorderSizePixel = 0, ZIndex = 8,
    }, card)
    corner(avRing, 99)

    local avatar = new("ImageLabel", {
        Name = "avatar",
        AnchorPoint = Vector2.new(0.5, 0.5),
        Position = UDim2.new(0.5, 0, 0.5, 0),
        Size = UDim2.fromOffset(36, 36),
        BackgroundColor3 = self.bgColor,
        BorderSizePixel = 0, ZIndex = 9,
    }, avRing)
    corner(avatar, 99)

    local nameLbl = new("TextLabel", {
        Name = "profileName", BackgroundTransparency = 1,
        Position = UDim2.fromOffset(56, 11),
        Size = UDim2.new(1, -64, 0, 15),
        Font = self.fontBold, TextSize = 12,
        TextXAlignment = Enum.TextXAlignment.Left,
        TextColor3 = self.textColor,
        TextTruncate = Enum.TextTruncate.AtEnd,
        Text = LP.DisplayName or LP.Name, ZIndex = 9,
    }, card)

    local userLbl = new("TextLabel", {
        Name = "profileUser", BackgroundTransparency = 1,
        Position = UDim2.fromOffset(56, 27),
        Size = UDim2.new(1, -64, 0, 13),
        Font = self.font, TextSize = 11,
        TextXAlignment = Enum.TextXAlignment.Left,
        TextColor3 = self.textMuted,
        TextTruncate = Enum.TextTruncate.AtEnd,
        Text = "@" .. LP.Name, ZIndex = 9,
    }, card)

    -- headshot is fetched async; the ring stands in until it lands
    task.spawn(function()
        local ok, id = pcall(function()
            return Players:GetUserThumbnailAsync(LP.UserId,
                Enum.ThumbnailType.HeadShot, Enum.ThumbnailSize.Size150x150)
        end)
        if ok and id and avatar.Parent then
            avatar.Image = id
            avatar.BackgroundTransparency = 1
        end
    end)

    self:OnTheme(function()
        avRing.BackgroundColor3 = self.accentColor
        nameLbl.TextColor3      = self.textColor
    end)

    local navScroll = new("ScrollingFrame", {
        Name = "navScroll", BackgroundTransparency = 1, BorderSizePixel = 0,
        Position = UDim2.fromOffset(8, 8),
        Size = UDim2.new(1, -16, 1, -(16 + CARD_H + 8)),
        ScrollBarThickness = 2,
        ScrollBarImageColor3 = self.accentColor,
        CanvasSize = UDim2.new(), ZIndex = 6,
    }, nav)
    local navList = list(navScroll, 4)

    -- ---------- content ----------
    local content = new("Frame", {
        Name = "content",
        Position = UDim2.fromOffset(PAD + NAV_W + PAD, HEADER_H + PAD),
        Size = UDim2.new(1, -(PAD * 3 + NAV_W), 1, -(HEADER_H + PAD * 2)),
        BackgroundTransparency = 1, BorderSizePixel = 0, ZIndex = 5,
    }, bg)

    local TabLibrary = { _tabs = {}, _current = nil }

    -- Re-flow every tab's columns for the current content width.
    local function relayout()
        local avail = content.AbsoluteSize.X
        if avail <= 0 then return end
        local cols = math.clamp(math.floor((avail + COL_GAP) / (COL_MIN + COL_GAP)), 1, 6)
        local colW = math.floor((avail - COL_GAP * (cols - 1)) / cols)
        for _, tab in ipairs(TabLibrary._tabs) do
            if tab._cols ~= cols then
                tab._cols = cols
                -- redistribute the groupboxes across the new column count
                for i, holder in ipairs(tab._boxes) do
                    holder.Parent = tab._columns[((i - 1) % cols) + 1]
                end
            end
            for i, col in ipairs(tab._columns) do
                col.Visible = i <= cols
                col.Size    = UDim2.new(0, colW, 1, 0)
            end
        end
    end
    TabLibrary._relayout = relayout
    self._relayout = relayout
    conn(content:GetPropertyChangedSignal("AbsoluteSize"):Connect(relayout))

    -- edges and the other corners drag; only bottom-right resizes
    self:AddEdgeHandles(edge, {
        minW = MIN_W, minH = MIN_H, maxW = MAX_W, maxH = MAX_H,
        onLive = function() relayout() end,
        onDone = function(w, h)
            self.windowWidth, self.windowHeight = w, h
            relayout()
        end,
    })

    -- ---------- tabs ----------
    function TabLibrary:NewTab(title)
        local page = new("ScrollingFrame", {
            Name = "page_" .. tostring(title),
            BackgroundTransparency = 1, BorderSizePixel = 0,
            Size = UDim2.new(1, 0, 1, 0), Visible = false,
            ScrollBarThickness = 3,
            ScrollBarImageColor3 = library.accentColor,
            AutomaticCanvasSize = Enum.AutomaticSize.Y,
            CanvasSize = UDim2.new(), ZIndex = 6,
        }, content)

        local grid = new("Frame", {
            Name = "grid", BackgroundTransparency = 1, BorderSizePixel = 0,
            Size = UDim2.new(1, 0, 0, 0),
            AutomaticSize = Enum.AutomaticSize.Y, ZIndex = 6,
        }, page)
        list(grid, COL_GAP, Enum.FillDirection.Horizontal)

        local tab = { _columns = {}, _boxes = {}, _cols = 0, _page = page, _next = 0 }
        -- six is what the widest supported window can fit; extras stay hidden
        for i = 1, 6 do
            local col = new("Frame", {
                Name = "col" .. i, BackgroundTransparency = 1, BorderSizePixel = 0,
                Size = UDim2.new(0, COL_MIN, 1, 0),
                AutomaticSize = Enum.AutomaticSize.Y,
                LayoutOrder = i, Visible = false, ZIndex = 6,
            }, grid)
            list(col, COL_GAP)
            tab._columns[i] = col
        end

        local btn = new("TextButton", {
            Name = "nav_" .. tostring(title),
            Size = UDim2.new(1, 0, 0, 26),
            BackgroundColor3 = library.accentSoft,
            BackgroundTransparency = 1,
            BorderSizePixel = 0, AutoButtonColor = false,
            Text = "", ZIndex = 7,
        }, navScroll)
        corner(btn, 4)
        local btnGlow = new("UIStroke", {
            Color = library.accentColor, Transparency = 1, Thickness = 1,
            ApplyStrokeMode = Enum.ApplyStrokeMode.Border,
        }, btn)

        local dot = new("Frame", {
            Name = "activeBar",
            Size = UDim2.fromOffset(2, 0),
            Position = UDim2.fromOffset(0, 0),
            BackgroundColor3 = library.accentColor,
            BackgroundTransparency = 1,
            BorderSizePixel = 0, ZIndex = 8,
        }, btn)

        local lbl = new("TextLabel", {
            BackgroundTransparency = 1,
            Position = UDim2.fromOffset(11, 0),
            Size = UDim2.new(1, -18, 1, 0),
            Font = library.fontMed, TextSize = 12,
            TextColor3 = library.textMuted,
            TextXAlignment = Enum.TextXAlignment.Left,
            TextTruncate = Enum.TextTruncate.AtEnd,
            Text = tostring(title), ZIndex = 8,
        }, btn)

        tab._btn, tab._dot, tab._lbl = btn, dot, lbl

        local function select()
            for _, t in ipairs(TabLibrary._tabs) do
                local on = (t == tab)
                if on and not t._page.Visible then
                    -- fade the incoming page up and settle it into place
                    t._page.Visible = true
                    local grid = t._page:FindFirstChild("grid")
                    if grid then
                        grid.Position = UDim2.fromOffset(0, 10)
                        tween(grid, 0.16, { Position = UDim2.fromOffset(0, 0) })
                        for _, d in ipairs(grid:GetDescendants()) do
                            if d:IsA("Frame") and d.Name == "groupbox" then
                                d.BackgroundTransparency = 1
                                tween(d, 0.2, { BackgroundTransparency = 0 })
                            end
                        end
                    end
                else
                    t._page.Visible = on
                end
                tween(t._btn, 0.14, { BackgroundTransparency = on and 0.86 or 1 })
                tween(t._lbl, 0.12, { TextColor3 = on and library.textColor or library.textMuted })
                t._dot.BackgroundColor3 = library.accentColor
                t._dot.Size = UDim2.new(0, 3, on and 1 or 0, 0)
                tween(t._dot, 0.14, { BackgroundTransparency = on and 0 or 1 })
                t._btn.BackgroundColor3 = library.accentColor
                tween(t._lbl, 0.14, { TextSize = on and 13 or 12 })
            end
            TabLibrary._current = tab
        end
        tab._select = select
        btn.MouseButton1Click:Connect(select)
        btn.MouseEnter:Connect(function()
            tween(btnGlow, 0.1, { Transparency = 0.6 })
            if TabLibrary._current ~= tab then
                tween(btn, 0.1, { BackgroundTransparency = 0.6 })
                tween(lbl, 0.1, { TextColor3 = library.textSecondary })
            end
        end)
        btn.MouseLeave:Connect(function()
            tween(btnGlow, 0.14, { Transparency = 1 })
            if TabLibrary._current ~= tab then
                tween(btn, 0.14, { BackgroundTransparency = 1 })
                tween(lbl, 0.14, { TextColor3 = library.textMuted })
            end
        end)

        TabLibrary._tabs[#TabLibrary._tabs + 1] = tab
        navScroll.CanvasSize = UDim2.fromOffset(0, #TabLibrary._tabs * 30 + 4)
        if #TabLibrary._tabs == 1 then select() end
        task.defer(relayout)

        -- ---------- containers ----------
        local Components = {}
        local function addBox(title2)
            tab._next = tab._next + 1
            local cols = math.max(tab._cols, 1)
            local col  = tab._columns[((tab._next - 1) % cols) + 1]
            local gb   = newGroupbox(col, title2)
            tab._boxes[#tab._boxes + 1] = gb._frame
            tab._boxObjs = tab._boxObjs or {}
            tab._boxObjs[#tab._boxObjs + 1] = gb
            return gb
        end
        function Components:AddLeftGroupbox(t)  return addBox(t) end
        function Components:AddMidGroupbox(t)   return addBox(t) end
        function Components:AddRightGroupbox(t) return addBox(t) end
        Components.AddGroupbox = Components.AddLeftGroupbox
        function Components:NewSection(t)       return addBox(t) end
        -- let a hub open or close everything at once
        function Components:ExpandAll()
            for _, g in ipairs(tab._boxObjs or {}) do
                if g._setOpen then pcall(g._setOpen, g, true) end
            end
        end
        function Components:CollapseAll()
            for _, g in ipairs(tab._boxObjs or {}) do
                if g._setOpen then pcall(g._setOpen, g, false) end
            end
        end
        Components._tab = tab
        return Components
    end

    -- open and close animate: a UIScale pops the window, and the children
    -- fade with it so it does not snap in and out
    local openScale = new("UIScale", { Scale = 1 }, edge)
    local animating = false
    local function setFade(t)
        for _, d in ipairs(edge:GetDescendants()) do
            pcall(function()
                if d:IsA("GuiObject") then
                    if d:GetAttribute("baseT") == nil then
                        d:SetAttribute("baseT", d.BackgroundTransparency)
                    end
                    local base = d:GetAttribute("baseT") or 0
                    d.BackgroundTransparency = base + (1 - base) * t
                elseif d:IsA("UIStroke") then
                    if d:GetAttribute("baseT") == nil then
                        d:SetAttribute("baseT", d.Transparency)
                    end
                    local base = d:GetAttribute("baseT") or 0
                    d.Transparency = base + (1 - base) * t
                end
            end)
        end
    end
    function TabLibrary:Show()
        if animating or edge.Visible then edge.Visible = true return TabLibrary end
        animating    = true
        edge.Visible = true
        openScale.Scale = 0.92
        setFade(1)
        tween(openScale, 0.18, { Scale = 1 })
        task.spawn(function()
            local t0 = os.clock()
            while os.clock() - t0 < 0.18 do
                setFade(1 - (os.clock() - t0) / 0.18)
                RUN.RenderStepped:Wait()
            end
            setFade(0)
            animating = false
        end)
        return TabLibrary
    end
    function TabLibrary:Hide()
        if animating or not edge.Visible then edge.Visible = false return TabLibrary end
        animating = true
        tween(openScale, 0.14, { Scale = 0.94 })
        task.spawn(function()
            local t0 = os.clock()
            while os.clock() - t0 < 0.14 do
                setFade((os.clock() - t0) / 0.14)
                RUN.RenderStepped:Wait()
            end
            edge.Visible    = false
            openScale.Scale = 1
            setFade(0)
            animating = false
        end)
        return TabLibrary
    end
    function TabLibrary:Toggle()
        if edge.Visible then TabLibrary:Hide() else TabLibrary:Show() end
        return TabLibrary
    end
    function TabLibrary:Text(t)  titleLbl.Text = tostring(t) return TabLibrary end
    function TabLibrary:UpdateKeybind(k)
        if typeof(k) == "string" then k = Enum.KeyCode[k] end
        toggleKey = k or toggleKey
        return TabLibrary
    end
    function TabLibrary:Center()
        edge.Position = UDim2.new(0.5, 0, 0.5, 0)
        return TabLibrary
    end

    conn(UIS.InputBegan:Connect(function(i, gpe)
        if gpe then return end
        if i.KeyCode == toggleKey then TabLibrary:Toggle() end
    end))

    self.ToggleMenu = function() TabLibrary:Toggle() end
    self._tabLibrary = TabLibrary
    task.defer(relayout)
    return TabLibrary
end

-- ===========================================================
-- Pop-out panels, notifications, and the odds and ends the hub
-- asks the library for.
--
-- A panel is the same frame the window is, at panel size, with
-- the same drag and the same edge resizing. There is no second
-- styling path, so they cannot drift apart.
-- ===========================================================

function library:MakePanel(name, title, w, h, x, y)
    w, h = w or 320, h or 400
    local hostGui = host()
    pcall(function()
        local old = hostGui:FindFirstChild(name)
        if old then old:Destroy() end
    end)

    local sg = new("ScreenGui", {
        Name = name, ResetOnSpawn = false, IgnoreGuiInset = true,
        ZIndexBehavior = Enum.ZIndexBehavior.Sibling, DisplayOrder = 500,
    }, hostGui)

    local edge, bg = self:BuildFrame(sg, w, h)
    edge.Position = UDim2.fromOffset(x or 80, y or 110)

    local header, titleLbl = self:BuildHeader(bg, title, 30)
    self:MakeDraggable(edge, header)

    local close = new("TextButton", {
        Name = "close",
        AnchorPoint = Vector2.new(1, 0.5),
        Position = UDim2.new(1, -10, 0.5, 0),
        Size = UDim2.fromOffset(20, 20),
        BackgroundTransparency = 1, BorderSizePixel = 0,
        AutoButtonColor = false,
        Font = self.fontBold, TextSize = 12,
        TextColor3 = self.textMuted, Text = "X", ZIndex = 9,
    }, header)
    close.MouseEnter:Connect(function() close.TextColor3 = self.accentColor end)
    close.MouseLeave:Connect(function() close.TextColor3 = self.textMuted end)
    close.MouseButton1Click:Connect(function() sg:Destroy() end)

    local content = new("Frame", {
        Name = "content", BackgroundTransparency = 1, BorderSizePixel = 0,
        Position = UDim2.fromOffset(0, 0), Size = UDim2.new(1, 0, 1, 0),
        ZIndex = 5,
    }, bg)

    self:AddEdgeHandles(edge, { minW = 230, minH = 150 })
    return sg, content, self:Skin(), titleLbl, edge
end

-- A groupbox outside a tab, for panel contents.
function library:PanelGroup(parent, title, height)
    local gb = newGroupbox(parent, title)
    if height then
        gb._frame.AutomaticSize = Enum.AutomaticSize.None
        gb._frame.Size = UDim2.new(1, 0, 0, height)
    end
    return gb._frame, gb._body, gb
end

function library:PanelStack(parent, pad)
    list(parent, pad or 8)
    return parent
end

-- ---------- notifications ----------
function library:InitNotifications()
    if self._notifyHolder and self._notifyHolder.Parent then return self._notifyHolder end
    local sg = new("ScreenGui", {
        Name = "droidware_notify", ResetOnSpawn = false, IgnoreGuiInset = true,
        DisplayOrder = 10000,
    }, host())
    self._screenGuis[#self._screenGuis + 1] = sg
    local holder = new("Frame", {
        Name = "holder", BackgroundTransparency = 1,
        AnchorPoint = Vector2.new(1, 1),
        Position = UDim2.new(1, -16, 1, -16),
        Size = UDim2.fromOffset(300, 500),
    }, sg)
    local l = list(holder, 8)
    l.VerticalAlignment = Enum.VerticalAlignment.Bottom
    l.HorizontalAlignment = Enum.HorizontalAlignment.Right
    self._notifyHolder = holder
    return holder
end

function library:Notify(text, duration, ...)
    local holder = self:InitNotifications()
    duration = tonumber(duration) or 4
    if type(text) == "table" then
        text = text.Content or text.Text or text.Title or "?"
    end

    local card = new("Frame", {
        Size = UDim2.new(0, 290, 0, 0),
        AutomaticSize = Enum.AutomaticSize.Y,
        BackgroundColor3 = self.edgeColor,
        BorderSizePixel = 0, ZIndex = 50,
    }, holder)
    corner(card, RADIUS)
    outline(card, self.accentColor, 0.2)

    local bar = new("Frame", {
        Size = UDim2.new(0, 3, 1, -14),
        Position = UDim2.fromOffset(8, 7),
        BackgroundColor3 = self.accentColor,
        BorderSizePixel = 0, ZIndex = 51,
    }, card)
    corner(bar, 2)

    new("TextLabel", {
        BackgroundTransparency = 1,
        Position = UDim2.fromOffset(19, 9),
        Size = UDim2.new(1, -30, 0, 0),
        AutomaticSize = Enum.AutomaticSize.Y,
        Font = self.font, TextSize = 12,
        TextColor3 = self.textColor,
        TextXAlignment = Enum.TextXAlignment.Left,
        TextWrapped = true,
        Text = tostring(text), ZIndex = 52,
    }, card)
    new("UIPadding", { PaddingBottom = UDim.new(0, 9) }, card)

    card.BackgroundTransparency = 1
    tween(card, 0.18, { BackgroundTransparency = 0 })
    task.delay(duration, function()
        pcall(function()
            tween(card, 0.2, { BackgroundTransparency = 1 })
            task.wait(0.22)
            card:Destroy()
        end)
    end)
    return card
end

-- ---------- misc helpers the hub uses ----------
function library:LiveWindow()
    if self._window and self._window.Parent then
        return self._window, self._window:FindFirstChild("background")
    end
    return nil, nil
end

function library:AddWindowResizeEdges() return true end   -- built in already
function library:LucideForTab() return "circle" end
function library:Watermark() end
function library:ImageWatermark() end

function library:CleanCharacterClone(model)
    for _, d in ipairs(model:GetDescendants()) do
        if d:IsA("Script") or d:IsA("LocalScript")
           or d:IsA("Attachment") or d:IsA("Beam") or d:IsA("Trail")
           or d:IsA("ParticleEmitter") or d:IsA("Highlight")
           or d:IsA("SelectionBox") or d:IsA("Constraint")
           or d:IsA("Fire") or d:IsA("Smoke") or d:IsA("Sparkles")
           or d:IsA("BillboardGui") or d:IsA("SurfaceGui") then
            pcall(function() d:Destroy() end)
        elseif d:IsA("BasePart") then
            d.Anchored, d.CanCollide, d.CastShadow = true, false, false
            pcall(function() d.LocalTransparencyModifier = 0 end)
        end
    end
    return model
end

-- Give a hand-built GUI the window's chrome.
function library:ReskinGui(gui)
    local main, best = nil, 0
    for _, c in ipairs(gui:GetChildren()) do
        if c:IsA("GuiObject") then
            local a = c.AbsoluteSize.X * c.AbsoluteSize.Y
            if a > best then main, best = c, a end
        end
    end
    if not main then return false end
    main.BackgroundColor3 = self.bgColor
    main.BorderSizePixel  = 0
    local c = main:FindFirstChildWhichIsA("UICorner") or new("UICorner", {}, main)
    c.CornerRadius = UDim.new(0, RADIUS)
    if not main:FindFirstChild("edgeAccent") then
        local s = outline(main, self.accentColor, 0.2)
        s.Name = "edgeAccent"
    end
    for _, d in ipairs(main:GetDescendants()) do
        pcall(function()
            if d:IsA("TextLabel") then
                if d.Font ~= Enum.Font.Code then d.Font = self.font end
                d.TextColor3 = self.textColor
            elseif d:IsA("TextButton") then
                if d.Font ~= Enum.Font.Code then d.Font = self.fontMed end
            end
        end)
    end
    return true, main
end

function library:Sweep(word, replacement)
    word, replacement = (word or "skyfall"):lower(), replacement or "DROIDWARE"
    for _, h in ipairs({ host(), game:GetService("CoreGui") }) do
        pcall(function()
            for _, g in ipairs(h:GetChildren()) do
                if g.Name == "watermark" or g.Name == "ImageWatermark" then g:Destroy() end
            end
        end)
    end
end

function library:Unload()
    for _, c in ipairs(self._connections) do pcall(function() c:Disconnect() end) end
    table.clear(self._connections)
    for _, g in ipairs(self._screenGuis) do pcall(function() g:Destroy() end) end
    table.clear(self._screenGuis)
    for _, fn in ipairs(self._unloadCallbacks or {}) do pcall(fn) end
end
library._unloadCallbacks = {}
function library:OnUnload(fn) self._unloadCallbacks[#self._unloadCallbacks + 1] = fn end
function library:SetWindowSize(w, h)
    self.windowWidth  = w or self.windowWidth
    self.windowHeight = h or self.windowHeight
    return self
end
function library:RegisterFlag(name, get, set) self._flags[name] = { get = get, set = set } end
function library:AddSoftGlow() end
function library:AddNoise() end

return library
